<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
				 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.acromere.pom</groupId>
		<artifactId>web</artifactId>
		<version>1.2-SNAPSHOT</version>
	</parent>

	<groupId>com.soniccandle</groupId>
	<artifactId>website</artifactId>
	<version>1.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>Sonic Candle Website</name>
	<description>The Sonic Candle website</description>
	<inceptionYear>2026</inceptionYear>

	<repositories>
		<repository>
			<id>acm</id>
			<url>https://repo.acromere.com/acm</url>
		</repository>
	</repositories>

	<pluginRepositories>
		<pluginRepository>
			<id>acm-plugin</id>
			<url>https://repo.acromere.com/acm</url>
		</pluginRepository>
	</pluginRepositories>

	<properties>
		<images-folder>target/main/images</images-folder>
	</properties>

	<dependencies>
<!--		<dependency>-->
<!--			<groupId>com.acromere</groupId>-->
<!--			<artifactId>zevra</artifactId>-->
<!--		</dependency>-->
<!--		<dependency>-->
<!--			<groupId>com.acromere</groupId>-->
<!--			<artifactId>zenna</artifactId>-->
<!--		</dependency>-->
		<dependency>
			<groupId>com.acromere</groupId>
			<artifactId>xenon</artifactId>
			<version>[2.0-SNAPSHOT,)</version>
		</dependency>
		<dependency>
			<groupId>com.acromere</groupId>
			<artifactId>sonic</artifactId>
			<version>[0.4,)</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency><!-- this triggers junit5 mode of surefire plugin -->
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.bytebuddy</groupId>
			<artifactId>byte-buddy-agent</artifactId>
			<version>${bytebuddy.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<finalName>soniccandle</finalName>

		<sourceDirectory>server/main/java</sourceDirectory>
		<outputDirectory>target/main/java</outputDirectory>
		<testSourceDirectory>server/test/java</testSourceDirectory>
		<testOutputDirectory>target/test/java</testOutputDirectory>

		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<addResources>true</addResources>
				</configuration>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<!-- Version comes from parent -->
				<configuration>
					<forkCount>1</forkCount>
					<argLine>
						-Xmx2048m
						-XX:MaxMetaspaceSize=512m
						-javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${bytebuddy.version}/byte-buddy-agent-${bytebuddy.version}.jar
						-javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar
					</argLine>
				</configuration>
			</plugin>

			<plugin>
				<groupId>com.acromere</groupId>
				<artifactId>cameo</artifactId>
				<executions>
					<execution>
						<id>render-images</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>render</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<images>
						<image>
							<class>com.acromere.sonic.icon.SonicCandleIcon</class>
							<target>${images-folder}/product.png</target>
							<theme>dark</theme>
						</image>
						<image>
							<class>com.acromere.sonic.icon.SonicCandleIcon</class>
							<target>${images-folder}/product-dark.png</target>
							<theme>dark</theme>
						</image>
						<image>
							<class>com.acromere.sonic.icon.SonicCandleIcon</class>
							<target>${images-folder}/product-light.png</target>
							<theme>light</theme>
						</image>
<!--						<image>-->
<!--							<class>com.acromere.sonic.icon.SonicCandleIcon</class>-->
<!--							<target>${images-folder}/product-avatar.png</target>-->
<!--							<theme>light</theme>-->
<!--							<offsetX>64</offsetX>-->
<!--							<offsetY>64</offsetY>-->
<!--							<imageWidth>384</imageWidth>-->
<!--							<imageHeight>384</imageHeight>-->
<!--						</image>-->
<!--						<image>-->
<!--							<class>com.acromere.sonic.icon.SonicCandleIcon</class>-->
<!--							<target>${images-folder}/product-avatar-circle.png</target>-->
<!--							<theme>light</theme>-->
<!--							<offsetX>64</offsetX>-->
<!--							<offsetY>40</offsetY>-->
<!--							<imageWidth>384</imageWidth>-->
<!--							<imageHeight>384</imageHeight>-->
<!--						</image>-->
					</images>
				</configuration>
			</plugin>

		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>acm-release</id>
			<url>https://repo.acromere.com/acm-release/</url>
		</repository>
		<snapshotRepository>
			<id>acm-snapshot</id>
			<url>https://repo.acromere.com/acm-snapshot/</url>
		</snapshotRepository>
	</distributionManagement>

</project>